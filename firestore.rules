rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(serverId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/servers/$(serverId)).data.members;
    }

    function otherMember(members) {
      return members[0] == request.auth.uid ? members[1] : members[0];
    }
    function pairOf(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function areFriends(a, b) {
      return exists(/databases/$(database)/documents/friendships/$(pairOf(a, b)));
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /servers/{serverId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 1;

      allow read: if isMember(serverId);

      allow update: if signedIn() && (
        // Owner can edit server name or channel list, but not membership/ownership.
        (resource.data.ownerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'channels']))
        ||
        // Existing members can add a channel.
        (request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['channels']))
        ||
        // A non-member can join only with a valid invite belonging to this server.
        (!(request.auth.uid in resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'joinCodeUsed'])
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members
          && exists(/databases/$(database)/documents/invites/$(request.resource.data.joinCodeUsed))
          && get(/databases/$(database)/documents/invites/$(request.resource.data.joinCodeUsed)).data.serverId == serverId)
        ||
        // A member can leave; the owner cannot leave until ownership is transferred.
        (request.auth.uid in resource.data.members
          && resource.data.ownerId != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && resource.data.members.hasAll(request.resource.data.members)
          && !(request.auth.uid in request.resource.data.members))
      );

      match /channels/{channelId} {
        allow read: if isMember(serverId);
        // getAfter: the server is created in the same batch as its first channel.
        allow create: if signedIn()
          && request.auth.uid in getAfter(/databases/$(database)/documents/servers/$(serverId)).data.members;
        allow update: if isMember(serverId);
        match /messages/{messageId} {
          allow read, create: if isMember(serverId)
            && (request.method != 'create' || (request.resource.data.uid == request.auth.uid
                && request.resource.data.get('image', '').size() < 500000));
        }
      }
    }

    // ---- Friends ----
    match /friendRequests/{reqId} {
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && reqId == request.resource.data.from + '_' + request.resource.data.to;
      allow read, delete: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    match /friendships/{pairId} {
      allow read, delete: if signedIn() && request.auth.uid in resource.data.members;
      // Created only when the other person's request to you exists.
      allow create: if signedIn()
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && pairId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && exists(/databases/$(database)/documents/friendRequests/$(otherMember(request.resource.data.members) + '_' + request.auth.uid));

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/friendships/$(pairId)).data.members;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/friendships/$(pairId)).data.members
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.get('image', '').size() < 500000;
      }
    }

    // ---- Voice calls (signalling only; audio goes peer to peer) ----
    match /calls/{callId} {
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && areFriends(request.resource.data.from, request.resource.data.to);
      allow read: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow update: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'status']);

      match /{side}/{candidateId} {
        allow read, create: if signedIn() && (
          get(/databases/$(database)/documents/calls/$(callId)).data.from == request.auth.uid
          || get(/databases/$(database)/documents/calls/$(callId)).data.to == request.auth.uid);
      }
    }

    match /invites/{inviteCode} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && existsAfter(/databases/$(database)/documents/servers/$(request.resource.data.serverId))
        && getAfter(/databases/$(database)/documents/servers/$(request.resource.data.serverId)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/servers/$(request.resource.data.serverId)).data.inviteCode == inviteCode;
      allow update, delete: if false;
    }
  }
}
