rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(serverId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/servers/$(serverId)).data.members;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /servers/{serverId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 1;

      allow read: if isMember(serverId);

      allow update: if signedIn() && (
        // Owner can edit server name or channel list, but not membership/ownership.
        (resource.data.ownerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'channels']))
        ||
        // Existing members can add a channel.
        (request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['channels']))
        ||
        // A non-member can join only with a valid invite belonging to this server.
        (!(request.auth.uid in resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'joinCodeUsed'])
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members
          && exists(/databases/$(database)/documents/invites/$(request.resource.data.joinCodeUsed))
          && get(/databases/$(database)/documents/invites/$(request.resource.data.joinCodeUsed)).data.serverId == serverId)
        ||
        // A member can leave; the owner cannot leave until ownership is transferred.
        (request.auth.uid in resource.data.members
          && resource.data.ownerId != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && resource.data.members.hasAll(request.resource.data.members)
          && !(request.auth.uid in request.resource.data.members))
      );

      match /channels/{channelId} {
        allow read, create: if isMember(serverId);
        allow update: if isMember(serverId);
        match /messages/{messageId} {
          allow read, create: if isMember(serverId)
            && (request.method != 'create' || request.resource.data.uid == request.auth.uid);
        }
      }
    }

    match /invites/{inviteCode} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && exists(/databases/$(database)/documents/servers/$(request.resource.data.serverId))
        && get(/databases/$(database)/documents/servers/$(request.resource.data.serverId)).data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/servers/$(request.resource.data.serverId)).data.inviteCode == inviteCode;
      allow update, delete: if false;
    }
  }
}
